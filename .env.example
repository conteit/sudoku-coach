# Firebase, for the optional Google sign-in (slice 2 of the accounts design).
#
# These four are public identifiers, not secrets: Vite compiles them into the
# browser bundle by design, and they identify the project rather than granting
# access to it. What actually protects the project is the Authorized domains
# list in Firebase Authentication.
#
# Leave them unset and the build simply has no sign-in — not a broken button,
# not an error. That is the local-first constraint taken literally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase UIDs and/or email addresses, comma-separated, that unlock the
# developer tools in the game menu (slice 4). Prefer UIDs: this value is
# readable in the shipped bundle, where a UID means nothing to a reader and an
# email address is a spam magnet.
VITE_DEV_ALLOWLIST=
